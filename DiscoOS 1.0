import os
import time
import platform
from datetime import datetime

NOMBRE = "DiscoOS"
VERSION = "1.0"


def limpiar():
    os.system("cls" if os.name == "nt" else "clear")


def pausa():
    input("\nPresiona ENTER para continuar...")


def inicio():
    limpiar()

    print("=" * 40)
    print("             DiscoOS")
    print("=" * 40)
    print("Iniciando sistema...")
    time.sleep(1)
    print("Sistema iniciado.")
    print("Versión:", VERSION)
    print("=" * 40)

    time.sleep(1)


def terminal():
    while True:
        limpiar()

        print("┌──────────────────────────────┐")
        print("│         DiscoOS Terminal     │")
        print("└──────────────────────────────┘")
        print()
        print("Escribe 'help' para ver los comandos.")
        print()

        comando = input("DiscoOS> ").strip()

        if comando == "help":
            print("""
Comandos:

help       - Mostrar comandos
clear      - Limpiar pantalla
time       - Mostrar hora
date       - Mostrar fecha
system     - Información del sistema
about      - Información de DiscoOS
echo texto - Mostrar texto
exit       - Salir
""")
            pausa()

        elif comando == "clear":
            continue

        elif comando == "time":
            print("Hora:", datetime.now().strftime("%H:%M:%S"))
            pausa()

        elif comando == "date":
            print("Fecha:", datetime.now().strftime("%d/%m/%Y"))
            pausa()

        elif comando == "system":
            print("Sistema:", platform.system())
            print("Arquitectura:", platform.machine())
            print("Python:", platform.python_version())
            pausa()

        elif comando == "about":
            print("DiscoOS")
            print("Mini sistema operativo de texto")
            print("Versión:", VERSION)
            print("Creado en Python.")
            pausa()

        elif comando.startswith("echo "):
            print(comando[5:])
            pausa()

        elif comando == "exit":
            break

        elif comando == "":
            pass

        else:
            print("Comando no encontrado.")
            pausa()


def calculadora():
    while True:
        limpiar()

        print("===== DiscoOS Calculator =====")
        print()
        print("1. Sumar")
        print("2. Restar")
        print("3. Multiplicar")
        print("4. Dividir")
        print("5. Volver")
        print()

        opcion = input("DiscoOS > ")

        if opcion == "5":
            break

        try:
            a = float(input("Número 1: "))
            b = float(input("Número 2: "))

            if opcion == "1":
                resultado = a + b

            elif opcion == "2":
                resultado = a - b

            elif opcion == "3":
                resultado = a * b

            elif opcion == "4":
                if b == 0:
                    print("Error: división entre cero.")
                    pausa()
                    continue

                resultado = a / b

            else:
                print("Opción inválida.")
                pausa()
                continue

            print("\nResultado:", resultado)
            pausa()

        except ValueError:
            print("Introduce números válidos.")
            pausa()


def informacion():
    limpiar()

    print("╔══════════════════════════════╗")
    print("║       INFORMACIÓN             ║")
    print("╚══════════════════════════════╝")
    print()
    print("Nombre:", NOMBRE)
    print("Versión:", VERSION)
    print("Python:", platform.python_version())
    print("Sistema:", platform.system())
    print("Arquitectura:", platform.machine())

    pausa()


def apagar():
    limpiar()

    print("DiscoOS está apagándose...")
    time.sleep(1)

    print()
    print("DiscoOS apagado.")
    print("Gracias por usar DiscoOS.")


def main():

    inicio()

    while True:

        limpiar()

        print("╔════════════════════════════════╗")
        print("║            DiscoOS             ║")
        print("╠════════════════════════════════╣")
        print("║ 1. Terminal                    ║")
        print("║ 2. Calculadora                 ║")
        print("║ 3. Información del sistema     ║")
        print("║ 4. Apagar                      ║")
        print("╚════════════════════════════════╝")
        print()

        opcion = input("DiscoOS > ")

        if opcion == "1":
            terminal()

        elif opcion == "2":
            calculadora()

        elif opcion == "3":
            informacion()

        elif opcion == "4":
            apagar()
            break

        else:
            print("Opción inválida.")
            time.sleep(1)


main()